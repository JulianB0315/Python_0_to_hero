   "source": [
    "# Conversión de grados Celsius a Fahrenheit\n",
    "def celsius_a_fahrenheit(c):\n",
    "    return c * 9/5 + 32\n",
    "\n",
    "# Ejemplo de uso\n",
    "grados_c = 25\n",
    "resultado = celsius_a_fahrenheit(grados_c)\n",
    "print(f\"{grados_c}°C = {resultado}°F\")"
   ]
  }
